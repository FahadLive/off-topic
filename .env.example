# Copy to .env for local `netlify dev`, and set the same values in the
# Netlify UI (Site configuration -> Environment variables) for production.

# Shared password used to sign in at /admin
ADMIN_PASSWORD=change-me

# Optional. Separate secret for signing the admin session cookie.
# Falls back to ADMIN_PASSWORD when unset.
ADMIN_SESSION_SECRET=

# Optional. Tally webhook signing secret (Tally: Form -> Integrations ->
# Webhooks -> Signing secret). When set, /api/tally rejects requests whose
# Tally-Signature header does not match.
TALLY_SIGNING_SECRET=
